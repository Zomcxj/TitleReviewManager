# .env.example
# 复制此文件为 .env 并填入你的配置

# 数据库连接 (开发时默认使用 SQLite)
DATABASE_URL="sqlite:///./title_service.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/title_service"

# JWT 密钥 (必须修改，用于生成和验证 Token)
JWT_SECRET_KEY="your-super-secret-and-complex-key"

# 存储后端 (local 或 smb)
STORAGE_BACKEND="local"
# NAS_ROOT="./nas_storage"
# SMB_USER=""
# SMB_PASS=""

# 允许的跨域来源 (逗号分隔)
ALLOWED_ORIGINS="http://localhost:5173"

# ---------- 外部通知渠道（可选）----------
# 站内通知始终生效；配置以下渠道后，重要通知会额外推送到邮件/Webhook，
# 让用户不登录也能收到提醒。未配置时静默跳过，不影响业务。
#
# 只推送这些类型的通知（逗号分隔；填 * 表示全部）
EXTERNAL_NOTIFY_TYPES="status_change,sla_overdue,pool_recovery"

# --- 邮件通知 ---
EMAIL_NOTIFY_ENABLED="0"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@example.com"
# 465 端口用 SSL（默认 1）；25/587 等端口设为 0
# SMTP_USE_SSL="1"
# 非 SSL 端口是否强制 STARTTLS（内网邮件服务器常不支持，默认 0）
# SMTP_USE_STARTTLS="0"

# --- Webhook 通知（企业微信/钉钉/飞书机器人等）---
WEBHOOK_NOTIFY_ENABLED="0"
# WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"


# ---------- 生产部署（docker compose）----------
# PostgreSQL 密码（compose 必填，不再使用硬编码弱密码）
# POSTGRES_PASSWORD="请设置强密码"
# POSTGRES_USER="titleadmin"
# POSTGRES_DB="titleservice"
# 应用对外端口
# APP_PORT="8000"
# uvicorn worker 进程数（按 CPU 核数调整）
# WEB_CONCURRENCY="4"

# ---------- 内置调度器 ----------
# SLA 自动回收 / 超时提醒的内置调度（默认开启，每 60 分钟一次）
# 若改用外部 cron 调用 tasks/sla_scheduler.py，设为 0
# SCHEDULER_ENABLED="1"
# SCHEDULER_INTERVAL_MINUTES="60"

# ---------- 数据自动备份 ----------
# 每天在 BACKUP_HOUR 点自动备份「数据库 + 材料文件」，默认保留最近 7 份。
# 备份由内置调度器执行（每 SCHEDULER_INTERVAL_MINUTES 检查一次，按小时判断），
# 失败只记日志，不影响业务。也可手动执行：python tasks/backup.py
# 或由管理员调用 POST /api/backup/run。
#
# 是否启用自动备份（默认 1）
# BACKUP_ENABLED="1"
# 备份存放目录（默认 backend/backups；建议指向独立磁盘或 NAS 挂载点）
# BACKUP_DIR="/data/backups"
# 保留最近多少份，超出自动删除最旧的（含 manifest）
# BACKUP_KEEP="7"
# 每天几点执行（0-23，默认 3 点凌晨）
# BACKUP_HOUR="3"
# 是否同时打包材料文件（默认 1）。数据量大时可设为 0 只备份数据库
# BACKUP_INCLUDE_FILES="1"
# 是否 gzip 压缩数据库备份（默认 1）
# BACKUP_COMPRESS="1"
#
# --- 恢复步骤 ---
# 1) 停掉后端服务，避免恢复过程中仍有写入。
# 2) 数据库：
#    SQLite —— gzip -dk db_<时间戳>.sqlite.gz，用解压出的 .sqlite 文件替换
#              DATABASE_URL 指向的库文件（先备份现有文件）。
#    PostgreSQL —— gzip -dk db_<时间戳>.sql.gz，
#              再 psql -U <user> -d <db> -f db_<时间戳>.sql（建议先建空库）。
# 3) 材料文件：tar -xzf files_<时间戳>.tar.gz -C <storage.get_storage_root() 目录>
#    （本地默认为项目根目录下的 nas_data/；生产为 NAS 挂载路径）
# 4) 重启服务，核对同目录 manifest_<时间戳>.json（记录备份时间、数据库类型、
#    数据库文件大小、材料文件数量与总大小、app 版本、是否成功）。
#
# PostgreSQL 备份依赖 pg_dump，请安装 postgresql-client
# （Debian/Ubuntu: apt-get install postgresql-client；Alpine: apk add postgresql-client）。


# ---------- HTTPS / 反向代理（生产必配）----------
# 是否位于 Nginx/Caddy 等反向代理之后。
# 开启后才会采信 X-Forwarded-For / X-Forwarded-Proto 来解析真实客户端 IP。
# 单机直连部署请保持 0 —— 否则客户端可伪造该头绕过登录限流。
# TRUST_PROXY="1"

# 强制 HTTPS：开启后 http 请求会被 301 跳转到 https（需配合 TRUST_PROXY 判断原始协议）
# FORCE_HTTPS="1"

# Cookie 是否带 Secure 属性（仅 https 传输）。
# 生产走 HTTPS 时必须设为 1；本地 http 开发保持 0，否则登录后 cookie 不会被发送。
# COOKIE_SECURE="1"

# 启用 HSTS（告诉浏览器后续强制走 https）。确认全站 HTTPS 可用后再开，否则会把自己锁在外面。
# ENABLE_HSTS="1"

# 对外访问地址（用于生成客户注册链接）
# PUBLIC_URL="https://your-domain.com"
