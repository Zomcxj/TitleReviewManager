# .env.example
# 复制此文件为 .env 并填入你的配置

# 数据库连接 (开发时默认使用 SQLite)
DATABASE_URL="sqlite:///./title_service.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/title_service"

# JWT 密钥 (必须修改，用于生成和验证 Token)
JWT_SECRET_KEY="your-super-secret-and-complex-key"

# 存储后端 (local 或 smb)
STORAGE_BACKEND="local"
# NAS_ROOT="./nas_storage"
# SMB_USER=""
# SMB_PASS=""

# 允许的跨域来源 (逗号分隔)
ALLOWED_ORIGINS="http://localhost:5173"

# ---------- 外部通知渠道（可选）----------
# 站内通知始终生效；配置以下渠道后，重要通知会额外推送到邮件/Webhook，
# 让用户不登录也能收到提醒。未配置时静默跳过，不影响业务。
#
# 只推送这些类型的通知（逗号分隔；填 * 表示全部）
EXTERNAL_NOTIFY_TYPES="status_change,sla_overdue,pool_recovery"

# --- 邮件通知 ---
EMAIL_NOTIFY_ENABLED="0"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@example.com"
# 465 端口用 SSL（默认 1）；25/587 等端口设为 0
# SMTP_USE_SSL="1"
# 非 SSL 端口是否强制 STARTTLS（内网邮件服务器常不支持，默认 0）
# SMTP_USE_STARTTLS="0"

# --- Webhook 通知（企业微信/钉钉/飞书机器人等）---
WEBHOOK_NOTIFY_ENABLED="0"
# WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"


# ---------- 生产部署（docker compose）----------
# PostgreSQL 密码（compose 必填，不再使用硬编码弱密码）
# POSTGRES_PASSWORD="请设置强密码"
# POSTGRES_USER="titleadmin"
# POSTGRES_DB="titleservice"
# 应用对外端口
# APP_PORT="8000"
# uvicorn worker 进程数（按 CPU 核数调整）
# WEB_CONCURRENCY="4"

# ---------- 内置调度器 ----------
# SLA 自动回收 / 超时提醒的内置调度（默认开启，每 60 分钟一次）
# 若改用外部 cron 调用 tasks/sla_scheduler.py，设为 0
# SCHEDULER_ENABLED="1"
# SCHEDULER_INTERVAL_MINUTES="60"
